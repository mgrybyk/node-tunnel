# Copy to agent.env. Use the same private 32-byte key as the relay.
N_T_CRYPT_KEY=

# Required: relay endpoint.
N_T_RELAY_HOST=relay.example.com
N_T_RELAY_PORT=1337
# Set true when the relay is behind a TLS proxy, such as HAProxy.
N_T_USE_TLS=false

# Required: route ID and target endpoint. Clients must use the same route ID.
N_T_ROUTE_ID=my-service
N_T_AGENT_DATA_HOST=127.0.0.1
N_T_AGENT_DATA_PORTS=8888
# Ordered lists and inclusive ranges are supported (at most 32 ports).
# N_T_AGENT_DATA_PORTS=8888,8800-8810,9000
# Duplicate and overlapping ports are rejected.

# Optional reliability tuning (milliseconds; jitter is a percentage).
# N_T_RECONNECT_DELAY_MS=4000
# N_T_RECONNECT_MAX_DELAY_MS=30000
# N_T_RECONNECT_JITTER_PERCENT=10
# N_T_HANDSHAKE_TIMEOUT_MS=5000
# N_T_HEARTBEAT_INTERVAL_MS=2000
# N_T_HEARTBEAT_TIMEOUT_MS=7000
# N_T_SHUTDOWN_TIMEOUT_MS=2000

# Optional diagnostics.
N_T_LOG_DEBUG=false
N_T_LOG_ERROR=false
