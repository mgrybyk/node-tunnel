# please set crypt key, do not use default outside local network
# key should be the same for relay, agents and clients

# N_T_CRYPT_KEY=b70231120900saamkb83gsc150f162fd

N_T_RELAY_HOST=localhost

N_T_RELAY_BIND_HOST=0.0.0.0 # change to 127.0.0.1 if the relay is behind a proxy
N_T_RELAY_PORT=1337

# used by agent and client, set to true is relay is behind TLS proxy, ex HAProxy
N_T_USE_TLS=false

# name up to 128 symbols length
N_T_CLIENT_NAME=dbg
N_T_CLIENT_BIND_HOST=127.0.0.1 # change to 0.0.0.0 if you want other clients in your network to access the client port
N_T_CLIENT_PORTS=9999
# To forward multiple ports, use an ordered list:
# N_T_CLIENT_PORTS=7777,5550-5560

# name up to 128 symbols length
N_T_AGENT_NAME=dbg
N_T_AGENT_DATA_HOST=localhost
N_T_AGENT_DATA_PORTS=8888
# To provide multiple targets, use an ordered list:
# N_T_AGENT_DATA_PORTS=8888,8800-8810,9000
# Lists map by position. Clients may use only the first N agent ports.
# Ranges include both endpoints; duplicate or overlapping ports are invalid.
# Each client and agent may configure at most 32 ports after expanding ranges.

# optional reliability tuning (milliseconds)
# N_T_RECONNECT_DELAY_MS=4000
# N_T_RECONNECT_MAX_DELAY_MS=30000
# Randomize each retry delay by ±10% to spread reconnects after an outage (0 disables).
# N_T_RECONNECT_JITTER_PERCENT=10
# N_T_HANDSHAKE_TIMEOUT_MS=5000
# N_T_CONTROL_IDLE_TIMEOUT_MS=15000
# N_T_HEARTBEAT_INTERVAL_MS=2000
# N_T_HEARTBEAT_TIMEOUT_MS=7000
# N_T_SHUTDOWN_TIMEOUT_MS=2000

# Temporarily enable both when tracing TLS/proxy stalls. Debug logs include
# concise connection/pairing events, TLS issuer, and byte totals at socket close.
N_T_LOG_DEBUG=false
N_T_LOG_ERROR=false
