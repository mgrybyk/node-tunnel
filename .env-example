# please set crypt key, do not use default outside local network
# key should be the same for server, agents and clients

# N_T_CRYPT_KEY=b70231120900saamkb83gsc150f162fd

N_T_SERVER_HOST=localhost
N_T_SERVER_PORT=1337
N_T_SERVER_PORTS_FROM=3005
N_T_SERVER_PORTS_TO=3009

# name up to 128 symbols length
N_T_CLIENT_NAME=dbg
N_T_CLIENT_PORT=9999

# name up to 128 symbols length
N_T_AGENT_NAME=dbg
N_T_AGENT_DATA_HOST=localhost
N_T_AGENT_DATA_PORT=8888

# optional reliability tuning (milliseconds)
# N_T_RECONNECT_DELAY_MS=5000
# N_T_HANDSHAKE_TIMEOUT_MS=10000
# N_T_CONTROL_IDLE_TIMEOUT_MS=45000

N_T_LOG_DEBUG=false
N_T_LOG_ERROR=false
