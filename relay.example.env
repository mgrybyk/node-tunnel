# Copy to relay.env. Generate a private key with: openssl rand -hex 16
# Set the same 32-byte key on the relay, agents, and clients.
N_T_CRYPT_KEY=

# Required: listen address and shared TCP port.
# Use 127.0.0.1 when the relay is behind a local proxy.
N_T_RELAY_BIND_HOST=0.0.0.0
N_T_RELAY_PORT=1337

# Optional reliability tuning (milliseconds).
# N_T_HANDSHAKE_TIMEOUT_MS=5000
# N_T_CONTROL_IDLE_TIMEOUT_MS=15000
# N_T_SHUTDOWN_TIMEOUT_MS=2000

# Optional diagnostics.
N_T_LOG_DEBUG=false
N_T_LOG_ERROR=false
