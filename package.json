{
  "name": "node-tunnel",
  "version": "0.5.0",
  "description": "Expose TCP services behind NAT through a relay on public a host",
  "main": "relay.js",
  "exports": {
    ".": "./relay.js",
    "./agent": "./agent.js",
    "./client": "./client.js",
    "./config": "./config.js",
    "./protocol": "./protocol.js"
  },
  "files": [
    "agent.js",
    "byte-channel.js",
    "client.js",
    "config.js",
    "lifecycle.js",
    "peer-session.js",
    "protocol.js",
    "relay.js",
    "tcp-data-transport.js",
    "utils.js",
    "benchmark",
    "example.env",
    "README.md",
    "docs/ARCHITECTURE.md",
    "docs/BENCHMARK.md",
    "docs/SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "c8": "^12.0.0"
  },
  "scripts": {
    "relay": "node relay.js",
    "agent": "node agent.js",
    "client": "node client.js",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "benchmark": "node benchmark/runner.js",
    "benchmark:compare": "node benchmark/compare.js",
    "test": "node --test --test-concurrency=3",
    "test:coverage": "c8 node --test --test-concurrency=2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgrybyk/node-tunnel.git"
  },
  "bugs": {
    "url": "https://github.com/mgrybyk/node-tunnel/issues"
  },
  "homepage": "https://github.com/mgrybyk/node-tunnel#readme",
  "keywords": [
    "tcp",
    "tunnel",
    "port-forwarding",
    "nat"
  ],
  "author": "mgrybyk",
  "license": "MIT"
}
